// Layer norm over rows, one block of {{NT}} threads per row (256, or 1024 for few long rows;
// two-pass mean / variance; the row is re-read per pass, which hits L1 for model-sized
// rows). Every loop step covers 4 * NT elements with all loads issued before the math.
// Params: [rows, cols, eps_bits]. Flag RMS: RMS norm (no mean, no bias): x * rsqrt(mean(x^2) + eps) * w.
.shared .align 16 .f32 red[32];

.visible .entry lapid_main(
{{ARGS}}
)
{
    .reg .pred %p;
    .reg .b32 %row, %cols, %base, %j, %tx, %lane, %warp;
    .reg .f32 %sum, %sq, %mean, %rstd, %eps, %fcols;
{{PTRS}}
    mov.u32 %tx, %tid.x;
    and.b32 %lane, %tx, 31;
    shr.u32 %warp, %tx, 5;
    mov.u32 %row, %ctaid.x;
    ld.param.u32 %cols, [P+4];
    ld.param.f32 %eps, [P+8];
    cvt.rn.f32.u32 %fcols, %cols;
    mul.lo.u32 %base, %row, %cols;

    mov.f32 %sum, 0f00000000;
    mov.f32 %mean, 0f00000000;
    mov.u32 %j, %tx;
// #if !RMS
MEAN_LOOP:
    setp.ge.u32 %p, %j, %cols;
    @%p bra MEAN_DONE;
{{SUM4}}
    add.u32 %j, %j, {{STEP}};
    bra MEAN_LOOP;
MEAN_DONE:
{{REDUCE_SUM}}
    div.rn.f32 %mean, %sum, %fcols;
// #endif
    mov.f32 %sq, 0f00000000;
    mov.u32 %j, %tx;
VAR_LOOP:
    setp.ge.u32 %p, %j, %cols;
    @%p bra VAR_DONE;
{{SQ4}}
    add.u32 %j, %j, {{STEP}};
    bra VAR_LOOP;
VAR_DONE:
{{REDUCE_SQ}}
    div.rn.f32 %rstd, %sq, %fcols;
    add.f32 %rstd, %rstd, %eps;
    sqrt.rn.f32 %rstd, %rstd;
    rcp.rn.f32 %rstd, %rstd;
    mov.u32 %j, %tx;
OUT_LOOP:
    setp.ge.u32 %p, %j, %cols;
    @%p bra DONE;
{{OUT4}}
    add.u32 %j, %j, {{STEP}};
    bra OUT_LOOP;
DONE:
    ret;
}
